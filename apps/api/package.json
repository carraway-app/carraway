{
  "name": "@carraway/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts src/worker.ts src/dokumente/auszug-prozess.ts scripts/geheimnis-rotieren.ts ../../packages/db/scripts/migrate.ts --bundle --platform=node --target=node24 --format=esm --external:pg-native --external:@aws-sdk/client-s3 --external:@myriaddreamin/typst-ts-node-compiler --external:tesseract.js --external:@napi-rs/canvas --external:@tesseract.js-data/deu --external:@tesseract.js-data/eng --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --entry-names=[name] --outdir=dist && node -e \"require('node:fs').cpSync('../../packages/berichte/fonts', 'dist/schriften', { recursive: true })\"",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:leistung": "vitest run src/__tests__/crm-leistung.test.ts src/__tests__/import-leistung.test.ts src/__tests__/referenzdatensatz.test.ts",
    "worker": "tsx src/worker.ts",
    "seed:melde": "tsx src/melde/demo-cli.ts",
    "start:worker": "node dist/worker.js",
    "demo:dokumente": "tsx scripts/demo-dokumente.ts",
    "demo:postfach": "tsx scripts/demo-postfach.ts",
    "geheimnis:rotieren": "tsx scripts/geheimnis-rotieren.ts"
  },
  "dependencies": {
    "@carraway/berichte": "workspace:*",
    "@carraway/db": "workspace:*",
    "@carraway/import": "workspace:*",
    "@carraway/rechenkern": "workspace:*",
    "@hono/node-server": "^1.19.0",
    "@hono/zod-validator": "^0.7.0",
    "@myriaddreamin/typst-ts-node-compiler": "0.7.0",
    "@napi-rs/canvas": "0.1.100",
    "@tesseract.js-data/deu": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "exceljs": "4.4.0",
    "hono": "^4.10.0",
    "imapflow": "2.11.0",
    "nodemailer": "10.4.1",
    "pg-boss": "12.38.0",
    "tesseract.js": "7.0.0",
    "unpdf": "2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@types/nodemailer": "8.0.2",
    "esbuild": "^0.25.0"
  }
}
