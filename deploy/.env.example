# Copy to .env. Keep it outside version control and back it up separately.
# Required settings
CARRAWAY_ENVIRONMENT=
# demo = practice, test = acceptance, echt = production (requires HTTPS).
APP_ORIGIN=
# Browser origin, for example https://fund.example.org or http://localhost:8787 for a local test.
BETTER_AUTH_SECRET=
# Generate with openssl rand -base64 48. Keep this key for sessions and authenticator credentials.
DB_ADMIN_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
# Generate three separate values with openssl rand -hex 24. Use letters, digits, _ or -.
# Keep existing database credentials on upgrade. Change passwords in Postgres before editing .env.

# Optional database and deployment settings
# DB_NAME=carraway
# DB_ADMIN_USER=carraway_admin
# COMPOSE_PROJECT_NAME=carraway
# CARRAWAY_IMAGE=ghcr.io/carraway-app/carraway:0.2
# API_BIND=127.0.0.1
# API_PORT=8787
# Set to 1 only behind a trusted proxy that sets X-Forwarded-For.
# TRUST_PROXY=0
# REQUIRE_TWO_FACTOR=1
# OPEN_REGISTRATION=0
# Optional for automated first setup. Generate with openssl rand -hex 32.
# When set, the API uses this token and omits it from the startup log.
# SETUP_TOKEN=

# Logging, Prometheus access and worker timing
# LOG_LEVEL=info
# METRICS_TOKEN=
# WORKER_INTERVAL_MS=2000
# WORKER_HEARTBEAT_MS=5000
# WORKER_MEMORY=3g

# Days to retain files after document deletion. OCR runs locally inside the worker.
# DOCUMENT_RETENTION_DAYS=30
# OCR=aus
# Use lokal to enable OCR.
# OCR_MAX_PAGES=20
# OCR_TIMEOUT_SECONDS=180
# OCR_MAX_MEGAPIXEL=40
# CAPITAL_VIEW=voll_verwaessert

# Mail delivery and mailbox access (see docs/security/mail-and-calendar.md)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# SMTP_FROM=
# MAIL_LIMIT_PER_HOUR=200
# Generate the mailbox encryption key with openssl rand -base64 32.
# SECRET_KEY=
# SECRET_KEY_PREVIOUS=
# MAILBOX_MICROSOFT_CLIENT_ID=
# MAILBOX_MICROSOFT_CLIENT_SECRET=
# MAILBOX_MICROSOFT_TENANT_ID=common
# MAILBOX_GOOGLE_CLIENT_ID=
# MAILBOX_GOOGLE_CLIENT_SECRET=
# MAILBOX_IMAP=1
# MAILBOX_PRIVATE_TARGETS=0
# MAILBOX_INTERVAL_MINUTES=15
# Local demo with docker-compose.demo.yml: SMTP_HOST=mailpit, SMTP_PORT=1025,
# SMTP_TLS=keine and SMTP_FROM=carraway@example.org.

# Register monitoring (disabled unless a provider and schedule are configured)
# REGISTER_PROVIDER=
# REGISTER_TEST_FILE=
# REGISTER_CHECK_CRON=
# REGISTER_REQUESTS_PER_RUN=20
# REGISTER_PAUSE_MS=3000

# Hosted extensions: single sign-on and AI document extraction
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT_ID=
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# Bestehende Konten mit derselben bestätigten Google-Adresse verknüpfen.
# OIDC_GOOGLE_KONTEN_VERKNUEPFEN=false
# AI_PROVIDER=aus
# AI_MODEL=
# AI_REGION=eu-central-1
# AI_ENDPOINT=
# AI_INBOX_DOMAINS=
# AI_INBOX_SENDERS=
# AI_INBOX_MAX_MB=10
# AI_TIMEOUT_MS=
# AI_BEDROCK_API_KEY=
# AI_MISTRAL_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
