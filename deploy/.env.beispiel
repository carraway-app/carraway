# Carraway: Einstellungen für deploy/docker-compose.yml
# Kopieren nach deploy/.env und ausfüllen. Die Datei .env gehört nie ins Repository.
# Zufallswerte: openssl rand -hex 24 (Datenbank-Passwörter), openssl rand -base64 48 (BETTER_AUTH_SECRET, METRIKEN_TOKEN).

# --- Pflicht ---------------------------------------------------------------------------------------------------------

# Bestand: demo (Übungs- und Vorführdaten), test (Abnahme und Probebetrieb) oder echt (Echtdaten). Der Wert steht im Banner der
# Oberfläche. Im Bestand "echt" sind HTTPS-Adressen und ein starkes BETTER_AUTH_SECRET vorgeschrieben, das Seed-Skript mit
# Demo-Daten ist gesperrt. Ein Bestand pro Stack und pro Datenbank; Demo, Test und Echt nie in derselben Datenbank mischen.
CARRAWAY_UMGEBUNG=

# Öffentliche Adresse, unter der die Oberfläche im Browser steht, ohne Pfad und ohne Schrägstrich am Ende.
# Mehrere Adressen mit Komma. Die erste ist die Basis für Cookies und Rückrufe der Firmenanmeldung.
APP_ORIGIN=

# Schlüssel für Sitzungen und die Verschlüsselung der Zwei-Faktor-Geheimnisse; mindestens 32 Zeichen. Wer ihn ändert, meldet
# alle Personen ab, und eingerichtete Authenticator-Apps müssen neu verbunden werden (Geheimnisse sind damit verschlüsselt).
BETTER_AUTH_SECRET=

# Datenbank: nur Buchstaben, Ziffern, _ und - (die Werte stehen in Verbindungsadressen und werden beim ersten Start in die
# Rollen übernommen; spätere Änderungen wirken nur über deploy/mandant-anlegen.sh bzw. ALTER ROLE).
DB_ADMIN_PASSWORT=
DB_EIGENTUEMER_PASSWORT=
DB_APP_PASSWORT=

# --- Datenbank (optional) --------------------------------------------------------------------------------------------

# Name der Datenbank; die Rollen heißen <name>_eigentuemer (Migrationen) und <name>_app (Betrieb).
# DB_NAME=carraway
# Superuser der Postgres-Instanz im Container (nur für Wartung, die Anwendung benutzt ihn nie).
# DB_ADMIN_BENUTZER=carraway_admin

# --- Netzwerk (optional) ---------------------------------------------------------------------------------------------

# Adresse und Port, auf denen die API auf dem Host lauscht. Vorgabe: nur dieser Rechner (Reverse-Proxy davor).
# API_BIND=127.0.0.1
# API_PORT=8787

# 1, wenn ein vertrauenswürdiger Reverse-Proxy davor steht, der X-Forwarded-For setzt: Dann gilt der letzte Eintrag als
# Adresse des Clients (Begrenzung der Fehlversuche je Adresse). Ohne Proxy auf 0 lassen, sonst kann jeder die Adresse fälschen.
# PROXY_VERTRAUEN=0

# --- Anmeldung (optional) --------------------------------------------------------------------------------------------

# Zweiter Faktor (TOTP) für alle Personen. 0 nur für Demo und Tests.
# ZWEI_FAKTOR_PFLICHT=1
# Offene Selbstregistrierung. Vorgabe 0: Nur die erste Person (wird Verwalter) und Anlage durch Verwalter.
# REGISTRIERUNG_OFFEN=0

# Firmenanmeldung über Microsoft Entra ID (Tenant-ID des Kunden, nicht "common") und/oder Google (Erweiterung, nur im Hosting durch Rehlytics). Ein Anbieter gilt nur, wenn
# Client-ID und Geheimnis gesetzt sind. Rückruf-Adresse beim Anbieter: <APP_ORIGIN>/api/v1/auth/callback/<microsoft|google>
# OIDC_MICROSOFT_CLIENT_ID=
# OIDC_MICROSOFT_CLIENT_SECRET=
# OIDC_MICROSOFT_TENANT_ID=
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=

# --- Beobachtung (optional) ------------------------------------------------------------------------------------------

# Mindeststufe der JSON-Logs: debug, info, warn oder error.
# LOG_STUFE=info
# Token für GET /metriken (Prometheus, Kopfzeile "Authorization: Bearer <token>"); mindestens 24 Zeichen. Leer: Endpunkt aus (404).
# METRIKEN_TOKEN=
# Takt des Workers (Millisekunden): Abholen neuer Aufträge und Herzschlag.
# WORKER_INTERVALL_MS=2000
# WORKER_HERZSCHLAG_MS=5000

# --- Image (optional) ------------------------------------------------------------------------------------------------

# Variante des Images (docs/open-core.md): kern (Vorgabe). Die Variante voll mit den Erweiterungen gibt es nur im Hosting durch Rehlytics
# (Image aus der privaten Registry); ein Bau mit voll ohne den Ordner ee/ bricht ab.
# CARRAWAY_VARIANTE=kern
# Fertiges Image statt lokalem Bau, z. B. aus der eigenen Registry. Ohne Angabe baut `docker compose up --build` aus dem Repository.
# CARRAWAY_IMAGE=carraway:kern
# Projektname; ändern, wenn mehrere Stacks auf einem Host laufen.
# COMPOSE_PROJECT_NAME=carraway

# --- KI-Auslesung (Standard: aus; Erweiterung, nur im Hosting durch Rehlytics) --------------------------------------------
# aus | bedrock_eu | mistral_eu | lokal (regelbasiert, nur für Test und Demo). Nur Anbieter in der EU; Einzelheiten in docs/sicherheit/KI-Auslesung.md.
# KI_ANBIETER=aus
# Modellkennung des Anbieters (Pflicht bei bedrock_eu und mistral_eu).
# KI_MODELL=
# Nur bedrock_eu: EU-Region (Standard eu-central-1) und Zugang (API-Schlüssel oder AWS-Schlüsselpaar).
# KI_REGION=eu-central-1
# KI_BEDROCK_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Nur mistral_eu:
# KI_MISTRAL_API_KEY=

# --- Dokumente ---------------------------------------------------------------------------------------------------------
# Tage, die die Datei eines gelöschten Dokuments in der Ablage bleibt; danach entfernt der Worker sie, sofern nichts anderes sie braucht (Standard 30).
# DOKUMENT_AUFBEWAHRUNG_TAGE=30

# --- Kapitaltabelle ----------------------------------------------------------------------------------------------------
# Standard-Sicht: voll_verwaessert (Vorgabe, mit Pool der Mitarbeiterbeteiligung) oder unverwaessert.
# KAPITAL_SICHT=voll_verwaessert

# Lokale Texterkennung (OCR) für Scans ohne Textebene und für Bilder: aus (Standard) oder lokal. Läuft im Worker im eigenen Prozess mit tesseract.js und
# den Sprachdaten Deutsch und Englisch aus dem Image; es werden keine Daten versendet und nichts nachgeladen.
# OCR=aus
# OCR_MAX_SEITEN=20
# OCR_ZEITLIMIT_SEKUNDEN=180
# Höchstzahl Megapixel je Seite oder Bild (Standard 40); Speicher des Workers insgesamt: WORKER_SPEICHER (Standard 3g).
# OCR_MAX_MEGAPIXEL=40

# --- Mail und Kalender (Standard: aus) -------------------------------------------------------------------------------------
# Einzelheiten, Datenschutz und Schlüsselwechsel: docs/sicherheit/Mail-und-Kalender.md
# Ausgehende Mail über SMTP. Ohne SMTP_HOST ist der Versand aus (Links lassen sich weiter kopieren).
# SMTP_HOST=smtp.fonds.example.org
# SMTP_PORT=587
# starttls (Standard) | tls (von Anfang an, Port 465) | keine (nur Demo und Entwicklung, im Echtbestand verboten)
# SMTP_TLS=starttls
# SMTP_BENUTZER=
# SMTP_PASSWORT=
# Alternativ eine Datei, z. B. ein Docker-Secret: SMTP_PASSWORT_DATEI=/run/secrets/smtp_passwort
# SMTP_ABSENDER=carraway@fonds.example.org
# Höchstens so viele Mails je Stunde und Installation (Standard 200).
# MAIL_LIMIT_PRO_STUNDE=200
# Schlüssel für Zugangsdaten der Postfachanbindung und für Mails mit Link (32 Byte, Base64: openssl rand -base64 32). Ohne ihn bleiben beides aus.
# Beim Wechsel den bisherigen Schlüssel hier eintragen (kommagetrennt), `pnpm --filter @carraway/api geheimnis:rotieren` ausführen, danach entfernen.
# GEHEIMNIS_SCHLUESSEL=
# GEHEIMNIS_SCHLUESSEL_ALT=
# Anbindung von Postfach und Kalender: App-Registrierungen der Installation (nur Leserechte), getrennt von den Anmeldungen oben.
# Rückruf-Adresse beim Anbieter: <APP_ORIGIN>/api/v1/postfach/rueckruf
# POSTFACH_MICROSOFT_CLIENT_ID=
# POSTFACH_MICROSOFT_CLIENT_SECRET=
# POSTFACH_MICROSOFT_TENANT_ID=common
# POSTFACH_GOOGLE_CLIENT_ID=
# POSTFACH_GOOGLE_CLIENT_SECRET=
# IMAP für eigene Mailserver (Standard an) und ob IMAP-Ziele in privaten Netzen erlaubt sind (Standard aus, Schutz vor Abfragen interner Dienste).
# POSTFACH_IMAP=1
# POSTFACH_PRIVATE_ZIELE=0
# Abstand der Abgleiche je Verbindung in Minuten (Standard 15).
# POSTFACH_INTERVALL_MINUTEN=15
# Demo: Mailfänger statt echtem Versand, `docker compose --profile demo-mail up -d`, Oberfläche auf http://127.0.0.1:8025
# SMTP_HOST=mailpit
# SMTP_PORT=1025
# SMTP_TLS=keine
# SMTP_ABSENDER=carraway@beispiel.example
# --- Registerdaten (Standard: aus) ---------------------------------------------------------------------------------------
# Carraway ruft Registerportale nicht automatisch ab (docs/register/zugang.md). Ein Anbieter ist eine eingerichtete, lizenzierte
# Schnittstelle; mitgeliefert ist nur `test` (feste Daten aus REGISTER_TESTDATEI, kein Netzwerk).
# REGISTER_ANBIETER=
# REGISTER_TESTDATEI=
# Beobachtung (Worker): Plan im Cron-Format, z. B. täglich um 5 Uhr. Ohne Plan und ohne Anbieter läuft nichts.
# REGISTER_PRUEFUNG_CRON=
# Höchstzahl Unternehmen je Lauf (Vorgabe 20) und Pause zwischen den Abrufen in Millisekunden (Vorgabe 3000).
# REGISTER_ABRUFE_PRO_LAUF=20
# REGISTER_PAUSE_MS=3000
